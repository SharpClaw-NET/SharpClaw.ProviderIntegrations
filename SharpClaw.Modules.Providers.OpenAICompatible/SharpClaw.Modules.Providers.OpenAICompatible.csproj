<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>SharpClaw.Modules.Providers.OpenAICompatible</PackageId>
        <Description>SharpClaw provider module that registers OpenAI-compatible remote provider integrations.</Description>
        <PackageTags>SharpClaw;providers;openai;ai</PackageTags>
        <ProviderModuleId>sharpclaw_providers_openai_compat</ProviderModuleId>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackProviderModuleEntryAssembly</TargetsForTfmSpecificContentInPackage>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="SharpClaw.Contracts" />
        <PackageReference Include="SharpClaw.ModuleSDK" PrivateAssets="all" IncludeAssets="compile;build;buildTransitive" />
        <ProjectReference Include="..\SharpClaw.Providers.Common\SharpClaw.Providers.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="package.json"
                 Link="contributions\sharpclaw_providers_openai_compat\package.json"
                 CopyToOutputDirectory="PreserveNewest"
                 Pack="true"
                 PackagePath="contentFiles\any\$(TargetFramework)\contributions\sharpclaw_providers_openai_compat\package.json"
                 PackageCopyToOutput="true" />
    </ItemGroup>
</Project>
